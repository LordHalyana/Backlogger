# Backlogger configuration
# Bind to all interfaces so the app is reachable from other devices on the LAN.
BACKLOGGER_HOST=0.0.0.0
BACKLOGGER_PORT=3333
BACKLOGGER_DATA_DIR=./data

# CORS: comma-separated allow-list of origins, or `*` to reflect any origin.
# `*` is convenient for self-hosted LAN access (e.g. http://192.168.x.y:5173).
# To lock down, set explicitly, e.g.:
#   BACKLOGGER_ALLOWED_ORIGINS=http://192.168.1.10:5173,http://laptop.local:5173
BACKLOGGER_ALLOWED_ORIGINS=*

# Vite dev server port (web). Vite also binds 0.0.0.0 so it's LAN-reachable.
BACKLOGGER_WEB_PORT=5173

LOG_LEVEL=info
